  "knownSandboxLimitations": {
    "fedexNGtoNG": "FedEx sandbox returns SYSTEM.UNAVAILABLE.EXCEPTION for NG domestic routes. Backend correctly falls back to haversine pricing.",
    "fedexTracking": "FedEx sandbox returns 403 FORBIDDEN for tracking calls. Works on live production account.",
    "dhlTracking": "DHL tracking returns 401 if the app has not been subscribed to the 'Shipment Tracking' API on developer.dhl.com.",
    "stripeWebhook": "Stripe sandbox fires webhooks; test the payment flow end-to-end in Stripe test mode before going live."
  },

  "bugsFounds_and_fixed": [
    {
      "bug": "review.userId was being used as the buyer, but it is actually the designer (tailor who created the quote). Buyer is material.userId.",
      "impact": "Carrier rates and delivery cost were computing NG→NG routes even when the buyer was in the US.",
      "fix": "Both deliveryRate and tracking controllers now look up buyer via Material.findById(review.materialId).userId."
    },
    {
      "bug": "User schema did not include city, state, postalCode fields.",
      "impact": "Carrier address had empty city/state and defaulted to postalCode '100001' (Lagos) for all buyers.",
      "fix": "Added optional city, state, postalCode fields to User schema. FedEx NG→US now correctly resolves NY 10001 as recipient."
    },
    {
      "bug": "FedEx international shipment missing customsClearanceDetail.",
      "impact": "FedEx returned TOTALCUSTOMSVALUE.REQUIRED for all international shipment creation attempts.",
      "fix": "Tracking controller now auto-builds customsClearanceDetail for international routes by looking up the review's quoted USD price."
    },
    {
      "bug": "FedEx shipment error body was lost through the error middleware (only err.message was passed).",
      "impact": "Error responses showed 'Request failed with status code 400' instead of the actual FedEx error code and message.",
      "fix": "fedexCreateShipment now catches axios errors and re-throws with err.status and err.fedexCode. Error middleware passes fedexCode through."
    }
  ]
}
